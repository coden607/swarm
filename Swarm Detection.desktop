[Desktop Entry]
Version=1.0
Type=Application
Name=Swarm Detection – One‑Click Installer
Comment=Installs and starts Swarm Detection
Icon=network-workgroup
Exec=sh -c "curl -fsSL https://raw.githubusercontent.com/coden607/swarm/main/install.sh | sh; printf 'Press Enter to close'; read x"
Terminal=true
Categories=Utility;Network;
StartupNotify=false
